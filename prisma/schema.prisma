generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Order {
  id        String      @id @default(cuid())
  status    OrderStatus @default(PENDING_REVIEW)
  customerId String
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum OrderStatus {
  PENDING_REVIEW
  APPROVED
  AWAITING_PAYMENT
  PAID
  REJECTED
  FULFILLED
}